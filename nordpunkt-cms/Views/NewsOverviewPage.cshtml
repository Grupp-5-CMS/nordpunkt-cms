@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Extensions
@using System
@using System.Linq
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<NewsOverviewPage>

@{
    // Använder Nordpunkts gemensamma layout
    Layout = "mainLayout.cshtml";

    // Hämtar startsidan
    var home = Model.Root();

    // Hämtar mappen Nyhetsartiklar under Home
    var newsFolder = home.Children<NewsFolder>().FirstOrDefault();

    // Hämtar kategori-filter från query string
    var categoryFilter = Context.Request.Query["category"].ToString();

    // Hämtar alla artiklar för att bygga kategorilista
    var allArticles = newsFolder?.Children<NewsArticlePage>() ?? Enumerable.Empty<NewsArticlePage>();
    var categories = allArticles
        .Where(x => !string.IsNullOrWhiteSpace(x.ArticleCategory))
        .Select(x => x.ArticleCategory.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    // Hämtar artiklar, filtrerar på kategori om angiven och sorterar med senaste först
    var articles = allArticles
        .Where(x => string.IsNullOrWhiteSpace(categoryFilter) ||
                    string.Equals(x.ArticleCategory, categoryFilter, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(x => x.PublishDate ?? DateOnly.FromDateTime(x.CreateDate))
        .ToList();
}

<section class="container mx-auto px-4 py-12 max-w-6xl">

    @* Lilla texten ovanför rubriken *@
    <p class="text-xs uppercase tracking-wide text-[#97533F] mb-4">
        Nyheter &amp; perspektiv
    </p>

    @* Sidans huvudrubrik *@
    <h1 class="font-serif text-5xl text-[#222320] mb-6">
        @(string.IsNullOrWhiteSpace(categoryFilter) ? "Alla nyheter" : $"Nyheter: {categoryFilter}")
    </h1>

    @* Kategorifilter *@
    @* Vanligt GET-formulär: fungerar även utan JavaScript, onchange skickar direkt *@
    <form method="get" action="@Model.Url()" class="category-filter mb-10">
        <label for="categoryFilter" class="category-filter__label">Kategori</label>
        <div class="category-filter__select-wrap">
            <select id="categoryFilter" name="category"
                    class="category-filter__select"
                    onchange="if (this.value) { this.form.submit(); } else { window.location.href = this.form.action; }">
                <option value="" selected="@string.IsNullOrWhiteSpace(categoryFilter)">Alla kategorier</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat" selected="@string.Equals(categoryFilter, cat, StringComparison.OrdinalIgnoreCase)">@cat</option>
                }
            </select>
        </div>
        <noscript><button type="submit" class="category-filter__submit">Filtrera</button></noscript>
        @if (!string.IsNullOrWhiteSpace(categoryFilter))
        {
            <a href="@Model.Url()" class="category-filter__clear">Rensa filter ×</a>
        }
    </form>

    @if (!articles.Any())
    {
        <p class="border-t border-[#D6D6CF] py-8 text-sm text-[#74756E]">
            Inga artiklar hittades i kategorin “@categoryFilter”.
        </p>
    }

    @* Visar samtliga publicerade artiklar *@
    @foreach (var article in articles)
    {
        <article class="border-t border-[#D6D6CF] py-8 md:flex gap-8">

            @* Klickbar artikelbild *@
            @if (article.ArticleImage != null)
            {
                <a href="@article.Url()" class="md:w-1/3">
                    <img src="@article.ArticleImage.Url()"
                         alt="@article.ArticleImage.Name"
                         class="w-full h-auto object-cover" />
                </a>
            }

            <div class="flex-1">

                @* Artikelns publiceringsdatum *@
                @if (article.PublishDate.HasValue)
                {
                    <p class="text-xs text-[#74756E] mb-2">
                        @article.PublishDate.Value.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                    </p>
                }

                @* Artikelns rubrik *@
                <h2 class="font-serif text-3xl text-[#222320] mb-3">
                    @article.ArticleTitle
                </h2>

                @* Artikelns ingress *@
                <p class="text-sm text-[#74756E] mb-4">
                    @article.Intro
                </p>

                @* Länk till hela artikeln *@
                <a href="@article.Url()" class="text-sm text-[#97533F]">
                    Läs hela artikeln →
                </a>

            </div>
        </article>
    }

</section>