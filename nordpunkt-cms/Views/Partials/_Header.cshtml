@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    // Hämta startsidan
    var home = Model.Root();
    var homeUrl = home?.Url() ?? "/";

    // Hämta navigationssidor dynamiskt från Umbraco
    // Endast Nyheter och Tipsa redaktionen visas
    var navigationPages = home?.Children()
        .Where(x =>
            x.IsVisible() &&
            (x.ContentType.Alias == "newsOverviewPage" ||
             x.ContentType.Alias == "tipPage"))
        .OrderBy(x => x.SortOrder)
        .ToList();

    // Kontrollera om startsidan är aktiv
    var isHome = Model.Id == home?.Id;
}

<header class="bg-white">

    @* Huvudnavigation *@
    <nav class="mx-auto flex w-full max-w-6xl items-center justify-between border-b border-[#D6D6CF] px-4 py-6"
         aria-label="Huvudnavigation">

        @* Logotyp *@
        <a href="@homeUrl"
           class="flex flex-col gap-0.5 no-underline">

            <span class="font-sans text-2xl font-bold tracking-tight text-[#222320]">
                NORDPUNKT<span class="text-[#97533F]">·</span>
            </span>

            <span class="text-[9px] uppercase tracking-[0.15em] text-[#74756E]">
                NYHETSBYRÅ
            </span>

        </a>

        @* Navigation för dator - dold på mobil *@
        <div class="hidden items-center gap-8 text-sm md:flex">

            @* Startsidan *@
            <a href="@homeUrl"
               class="border-b-2 py-2 !text-black transition-colors hover:text-[#97533F] @(isHome ? "border-[#97533F] font-semibold" : "border-transparent")"
               aria-current="@(isHome ? "page" : null)">
                Hem
            </a>

            @* Dynamiska länkar från Umbraco *@
            @if (navigationPages != null)
            {
                foreach (var navItem in navigationPages)
                {
                    // Kontrollera om sidan är aktiv
                    var isActive =
                        Model.Id == navItem.Id ||
                        Model.Ancestors().Any(x => x.Id == navItem.Id) ||
                        (navItem.ContentType.Alias == "newsOverviewPage" &&
                         Model.ContentType.Alias == "newsArticlePage");

                    <a href="@navItem.Url()"
                       class="border-b-2 py-2 !text-black transition-colors hover:text-[#97533F] @(isActive ? "border-[#97533F] font-semibold" : "border-transparent")"
                       aria-current="@(isActive ? "page" : null)">
                        @navItem.Name
                    </a>
                }
            }

            @* Sökknapp i headern *@
            <button type="button"
                id="search-button"
                class="flex cursor-pointer items-center justify-center p-2 text-[#222320]"
                aria-label="Öppna sökfältet"
                aria-controls="search-panel"
                aria-expanded="false">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="18"
                     height="18"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">

                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />

                </svg>
            </button>

        </div>


        @* Sökknapp för mobil *@
        <button type="button"
                id="mobile-search-button"
                class="ml-auto flex cursor-pointer items-center justify-center p-2 text-[#222320] md:hidden"
                aria-label="Öppna sökfältet"
                aria-controls="search-panel"
                aria-expanded="false">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">

                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
            </svg>
        </button>



        @* Hamburgermeny - visas endast på mobil *@
        <button type="button"
                id="mobile-menu-button"
                class="flex items-center justify-center p-2 text-[#222320] md:hidden"
                aria-label="Öppna menyn"
                aria-controls="mobile-menu"
                aria-expanded="false">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="28"
                 height="28"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>

        </button>

    </nav>
    
    @* Sökfält - dolt tills man klickar på sökikonen *@
    
    <div id="search-panel"
         class="mx-auto hidden w-full max-w-6xl border-b border-[#D6D6CF] px-4 py-5">
         
         <form action="/nyheter/" method="get"

         role="search"
         class="flex items-center gap-3">
         
         <input type="search"
             name="q"
             placeholder="Sök bland nyheter..."
             aria-label="Sök bland nyheter"
             class="w-full rounded border border-[#D6D6CF] bg-white px-4 py-3 text-sm outline-none focus:border-[#97533F]" />
             
             <button type="submit"
                    class="cursor-pointer rounded bg-[#97533F] px-5 py-3 text-sm text-white">
                 Sök
            </button>

        </form>
    </div>

    @* Mobilnavigation - visas när menyn öppnas *@
    <div id="mobile-menu"
         class="mx-auto hidden w-full max-w-6xl flex-col gap-4 border-b border-[#D6D6CF] px-4 py-5 text-sm md:hidden">

        @* Startsidan *@
        <a href="@homeUrl"
           class="!text-black @(isHome ? "font-semibold" : "")"
           aria-current="@(isHome ? "page" : null)">
            Hem
        </a>

        @* Dynamiska länkar för mobil *@
        @if (navigationPages != null)
        {
            foreach (var navItem in navigationPages)
            {
                // Kontrollera om sidan är aktiv
                var isActive =
                    Model.Id == navItem.Id ||
                    Model.Ancestors().Any(x => x.Id == navItem.Id) ||
                    (navItem.ContentType.Alias == "newsOverviewPage" &&
                     Model.ContentType.Alias == "newsArticlePage");

                <a href="@navItem.Url()"
                   class="!text-black @(isActive ? "font-semibold" : "")"
                   aria-current="@(isActive ? "page" : null)">
                    @navItem.Name
                </a>
            }
        }

    </div>

</header>

@* Öppna och stäng mobilmenyn *@
<script>
    (() => {
        const button = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-menu");

        if (!button || !menu) return;

        button.addEventListener("click", () => {

            const isOpen =
                button.getAttribute("aria-expanded") === "true";

            // Uppdatera om menyn är öppen eller stängd
            button.setAttribute(
                "aria-expanded",
                String(!isOpen)
            );

            // Uppdatera tillgänglighetstext
            button.setAttribute(
                "aria-label",
                isOpen ? "Öppna menyn" : "Stäng menyn"
            );

            // Visa eller dölj mobilmenyn
            menu.classList.toggle("hidden", isOpen);
            menu.classList.toggle("flex", !isOpen);

        });
    })();
</script>


<script>
    // Öppna och stäng sökfältet på dator och mobil
    (() => {
        const searchButtons = [
            document.getElementById("search-button"),
            document.getElementById("mobile-search-button")
        ];

        const searchPanel = document.getElementById("search-panel");

        if (!searchPanel) return;

        searchButtons.forEach(button => {
            if (!button) return;

            button.addEventListener("click", () => {
                const isOpen = !searchPanel.classList.contains("hidden");

                searchPanel.classList.toggle("hidden", isOpen);

                // Uppdatera båda knapparna
                searchButtons.forEach(btn => {
                    if (!btn) return;

                    btn.setAttribute("aria-expanded", String(!isOpen));
                    btn.setAttribute(
                        "aria-label",
                        isOpen ? "Öppna sökfältet" : "Stäng sökfältet"
                    );
                });

                // Placera markören i sökfältet
                if (!isOpen) {
                    searchPanel.querySelector("input")?.focus();
                }
            });
        });
    })();
</script>

