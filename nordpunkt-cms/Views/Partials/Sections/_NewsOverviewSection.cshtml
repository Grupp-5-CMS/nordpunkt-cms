@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HomePage>

@{
    // Hämtar mappen Nyhetsartiklar under Home
    var newsFolder = Model.Children<NewsFolder>().FirstOrDefault();

    // Hämtar de 5 senaste artiklarna från mappen
    var articles = newsFolder?.Children<NewsArticlePage>()
        .OrderByDescending(x => x.PublishDate ?? DateOnly.FromDateTime(x.CreateDate))
        .Take(5)
        ?? Enumerable.Empty<NewsArticlePage>();

    // Hämtar Nyheter-sidan så att kategorin kan länka till filtrerad lista
    var newsPage = Model.Children<NewsOverviewPage>().FirstOrDefault();
}

<section class="container mx-auto px-4 py-12 max-w-6xl">

    @* Lilla texten ovanför rubriken *@
    <p class="text-xs uppercase tracking-wide text-[#97533F] mb-4">
        Nyheter &amp; perspektiv
    </p>

    @* Huvudrubriken från Umbraco *@
    <h1 class="font-serif text-5xl text-[#222320] mb-10">
        @Model.OverviewTitle
    </h1>

    @* Visar en kort förhandsvisning av de 5 senaste artiklarna *@
    @foreach (var article in articles)
    {
        <article class="border-t border-[#D6D6CF] py-8 md:flex gap-8">

            @* Klickbar artikelbild *@
            @if (article.ArticleImage != null)
            {
                <a href="@article.Url()" class="md:w-1/3">
                    <img src="@article.ArticleImage.Url()"
                         alt="@article.ArticleImage.Name"
                         class="w-full h-auto object-cover" />
                </a>
            }

            <div class="flex-1">

                @* Kategori och publiceringsdatum på samma rad *@
                <div class="flex items-baseline gap-3 mb-2">

                    @* Artikelns kategori, länkar till filtrerad nyhetssida *@
                    @if (!string.IsNullOrWhiteSpace(article.ArticleCategory))
                    {
                        if (newsPage != null)
                        {
                            <a href="@newsPage.Url()?category=@Uri.EscapeDataString(article.ArticleCategory)"
                               class="text-sm text-[#97533F] hover:underline">
                                @article.ArticleCategory
                            </a>
                        }
                        else
                        {
                            <span class="text-sm text-[#97533F]">@article.ArticleCategory</span>
                        }
                    }

                    @* Publiceringsdatum *@
                    @if (article.PublishDate.HasValue)
                    {
                        <p class="text-xs text-[#74756E]">
                            @article.PublishDate.Value.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                        </p>
                    }

                </div>

                @* Artikelns rubrik *@
                <h2 class="font-serif text-3xl text-[#222320] mb-3">
                    @article.ArticleTitle
                </h2>

                @* Artikelns ingress, inte hela artikeltexten *@
                <p class="text-sm text-[#74756E] mb-4">
                    @article.Intro
                </p>

                @* Länk till hela artikelsidan *@
                <a href="@article.Url()" class="text-sm text-[#97533F]">
                    Läs hela artikeln →
                </a>

            </div>
        </article>
    }

</section>
