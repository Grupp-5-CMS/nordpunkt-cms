@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<NewsArticlePage>

@{
    Layout = "mainLayout.cshtml";

    // Hämtar startsidan
    var home = Model.Root();

    // Hämtar Nyheter-sidan under Home
    var newsPage = home?.Children()
        .FirstOrDefault(x => x.ContentType.Alias == "newsOverviewPage");

    // Länk till nyhetsöversikten, med startsidan som reserv
    var newsUrl = newsPage?.Url() ?? home?.Url() ?? "/";

    // Hämtar upp till 3 andra artiklar i samma kategori, nyast först
    var relatedArticles = Model.Parent()?.Children<NewsArticlePage>()
        .Where(x => x.Id != Model.Id
                    && string.Equals(x.ArticleCategory, Model.ArticleCategory, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(x => x.PublishDate ?? DateOnly.FromDateTime(x.CreateDate))
        .Take(3)
        .ToList() ?? new List<NewsArticlePage>();
}

<article class="mx-auto max-w-6xl px-6 py-12">

    @* Länk tillbaka till nyheterna *@
    <a href="@newsUrl" class="text-sm text-[#97533F]">
        ← Tillbaka till senaste nyheterna
    </a>

    <header class="mt-10 mb-8">

        @* Kategori och datum: större text och mer luft än i listorna *@
        <div class="flex flex-wrap items-center gap-5 mb-8">

            @* Artikelns kategori, länkar till filtrerad nyhetssida *@
            @if (!string.IsNullOrWhiteSpace(Model.ArticleCategory))
            {
                if (newsPage != null)
                {
                    <a href="@newsPage.Url()?category=@Uri.EscapeDataString(Model.ArticleCategory)"
                       class="text-base font-medium uppercase tracking-[0.12em] [font-family:var(--font-heading)] text-[#97533F] no-underline hover:underline underline-offset-4">
                        @Model.ArticleCategory
                    </a>
                }
                else
                {
                    <span class="text-base font-medium uppercase tracking-[0.12em] [font-family:var(--font-heading)] text-[#97533F]">@Model.ArticleCategory</span>
                }
            }

            @* Publiceringsdatum, med tunt streck före om kategori finns *@
            @if (Model.PublishDate.HasValue)
            {
                if (!string.IsNullOrWhiteSpace(Model.ArticleCategory))
                {
                    <span class="h-5 w-px bg-[#D6D6CF]" aria-hidden="true"></span>
                }
                <time datetime="@Model.PublishDate.Value.ToString("yyyy-MM-dd")" class="text-base text-[#74756E]">
                    @Model.PublishDate.Value.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                </time>
            }

        </div>

        <h1 class="font-serif text-5xl md:text-7xl font-normal leading-tight text-[#222320] max-w-4xl">
            @Model.ArticleTitle
        </h1>

    </header>

    @* Artikelbild och bildtext *@
    @if (Model.ArticleImage != null)
    {
        <figure class="mb-12">
            <img src="@Model.ArticleImage.Url()"
                 alt="@Model.ArticleImage.Name"
                 class="w-full aspect-[3/2] object-cover" />

            @if (!string.IsNullOrWhiteSpace(Model.ImageCaption))
            {
                <figcaption class="text-xs text-[#74756E] mt-2">
                    @Model.ImageCaption
                </figcaption>
            }
        </figure>
    }

    <div class="max-w-2xl mx-auto">

        @* Ingress *@
        <p class="font-serif text-2xl leading-relaxed text-[#222320] mb-10">
            @Model.Intro
        </p>

        <hr class="border-[#D6D6CF] mb-8" />

        @* Artikeltext *@
        <div class="font-serif text-lg leading-loose text-[#222320] space-y-6">
            @Model.ArticleBody
        </div>

        <hr class="border-[#D6D6CF] mt-12 mb-6" />

        @* Tillbaka till nyhetsöversikten *@
        <a href="@newsUrl" 
        
        class="text-sm text-[#97533F]">
            ← Alla nyheter
        </a>

    </div>

</article>

@* Relaterade artiklar, visas bara om det finns några *@
@if (relatedArticles.Any())
{
    <section class="mx-auto max-w-6xl px-6 pb-16">

        <h2 class="font-serif text-3xl text-[#222320] mb-8 border-t border-[#D6D6CF] pt-10">
            Fler nyheter om @Model.ArticleCategory
        </h2>

        <div class="grid gap-8 md:grid-cols-3">
            @foreach (var related in relatedArticles)
            {
                <a href="@related.Url()" class="group block no-underline">

                    @if (related.ArticleImage != null)
                    {
                        <img src="@related.ArticleImage.Url()"
                             alt="@related.ArticleImage.Name"
                             class="mb-4 aspect-[3/2] w-full object-cover" />
                    }

                    @if (related.PublishDate.HasValue)
                    {
                        <p class="text-xs text-[#74756E] mb-2">
                            @related.PublishDate.Value.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
                        </p>
                    }

                    <h3 class="font-serif text-xl text-[#222320] group-hover:underline">
                        @related.ArticleTitle
                    </h3>

                </a>
            }
        </div>

    </section>
}