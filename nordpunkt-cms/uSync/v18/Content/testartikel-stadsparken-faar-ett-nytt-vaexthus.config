    <articleTitle>
      <Value><![CDATA[Stadsparken får ett nytt växthus]]></Value>
    </articleTitle>
    <imageCaption>
      <Value><![CDATA[Det nya växthuset planeras att öppna till våren.]]></Value>
    </imageCaption>
    <intro>
      <Value><![CDATA[Ett nytt växthus ska ge stadsborna möjlighet att odla tillsammans året runt.]]></Value>
    </intro>
